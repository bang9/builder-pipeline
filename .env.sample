# ============================================
# Builder Pipeline - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
#   cp .env.sample .env
#
# NOTE: Keep this file in sync whenever a new env var is introduced.
# ============================================

# --- AI Provider ---
IMAGE_PROVIDER=google              # "google" (default) | "openai"

# --- Google ---
GOOGLE_GENERATIVE_AI_API_KEY=      # Required when IMAGE_PROVIDER=google

# --- OpenAI ---
OPENAI_API_KEY=                    # Required when IMAGE_PROVIDER=openai

# --- Apple ---
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
